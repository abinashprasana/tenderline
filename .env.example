# Copy to .env. Every variable the app reads. All have working local defaults (no accounts or keys needed).
ENV=dev                         # dev enables /v1/auth/dev-token. The app itself defaults to prod when this is unset
LOG_LEVEL=INFO
POSTGRES_PASSWORD=tenderline
APP_DB_PASSWORD=tenderline_app  # password of the non-superuser, RLS-subject role
DB_HOST_PORT=5433
APP_PORT=8000
JWT_SECRET=dev-only-change-me-dev-only-change-me   # MUST be unique when ENV=prod
JWT_TTL_MINUTES=60
GITHUB_CLIENT_ID=               # SETUP: GitHub OAuth app
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback
LLM_PROVIDER_CHAIN=fake         # comma list of: groq, gemini, ollama, fake (fallback order)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
GROQ_COST_PER_MTOK_IN=0         # USD per million tokens, from the provider's price list (for llm_calls.cost_usd)
GROQ_COST_PER_MTOK_OUT=0
GEMINI_COST_PER_MTOK_IN=0
GEMINI_COST_PER_MTOK_OUT=0
TED_COUNTRY=IRL
TED_EXTRA_CPV_PREFIXES=         # e.g. 72,48 to also ingest EU-wide notices in those CPV divisions
TED_MAX_REQUESTS_PER_MINUTE=60  # TED's limit is 700/min; this client refuses values above 600
INGEST_CRON=0 6 * * *
RATE_LIMIT_PER_MINUTE=6000      # per organisation
OPPORTUNITY_MAX_WAIT_SECONDS=3600
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # Grafana Cloud: its OTLP gateway URL
OTEL_EXPORTER_OTLP_HEADERS=                              # Grafana Cloud: Authorization=Basic <base64>
LANGFUSE_PUBLIC_KEY=            # optional; LLM traces off when empty
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
GRAFANA_ADMIN_PASSWORD=admin

# --- Advanced / host-run settings (defaults shown; compose sets the database URLs for you) ---
SERVICE_NAME=tenderline-api
WORKFLOWS_ENABLED=true          # start the DBOS runtime inside the API process
DATABASE_URL=postgresql+psycopg://tenderline:tenderline@localhost:5433/tenderline          # table owner: migrations only
APP_DATABASE_URL=postgresql+psycopg://tenderline_app:tenderline_app@localhost:5433/tenderline  # RLS-subject app role
DBOS_SYSTEM_DATABASE_URL=postgresql://tenderline:tenderline@localhost:5433/tenderline_dbos
TED_BASE_URL=https://api.ted.europa.eu
TED_PAGE_SIZE=100               # TED maximum is 250
TED_LOOKBACK_DAYS=7             # first-run / default ingestion window
INGEST_MAX_PAGES=40             # pages per run; an unfinished run resumes from its cursor
BACKFILL_QUALIFY_LIMIT=50       # matches auto-qualified when a saved search is created
WORKFLOW_RETENTION_DAYS=30      # finished workflow records older than this are deleted daily
IDEMPOTENCY_KEY_RETENTION_DAYS=7
APP_VERSION=                    # set to the release (e.g. the git SHA); DBOS resumes only same-version workflows
ENRICH_QUEUE_CONCURRENCY=4
QUALIFY_QUEUE_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=60
PROMPT_VERSION=qualify-v2       # part of the LLM cache key; bump when the prompt changes
GROQ_BASE_URL=https://api.groq.com/openai/v1
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
CONTACT_EMAIL=ops@example.invalid   # shown by GET /v1/metadata
