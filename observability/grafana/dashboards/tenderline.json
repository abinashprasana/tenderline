{
 "uid": "tenderline-overview",
 "title": "Tenderline overview",
 "tags": [
  "tenderline"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "API",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 2,
   "title": "API p95 latency",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(tenderline_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "title": "Requests per second by route",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_route) (rate(tenderline_http_request_duration_seconds_count[5m]))",
     "legendFormat": "{{http_route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "title": "Error rate (5xx)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(tenderline_http_request_duration_seconds_count{http_status_code=~\"5..\"}[5m])) / sum(rate(tenderline_http_request_duration_seconds_count[5m]))) or vector(0)",
     "legendFormat": "5xx ratio",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "row",
   "title": "Ingestion",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 6,
   "title": "Notices ingested (new, per hour)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (increase(tenderline_notices_ingested_total[1h]))",
     "legendFormat": "{{source}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 7,
   "title": "Ingest lag (hours since last successful run)",
   "type": "timeseries",
   "description": "Alert fires above 36h.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "tenderline_ingest_lag_seconds / 3600",
     "legendFormat": "hours",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 8,
   "title": "Workflow failures",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (workflow) (increase(tenderline_workflow_failures_total[1h])) or vector(0)",
     "legendFormat": "{{workflow}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "row",
   "title": "Queues",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 10,
   "title": "Queue depth",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (queue, status) (tenderline_queue_depth)",
     "legendFormat": "{{queue}} {{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 11,
   "title": "Qualified per hour (LLM calls ok)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(tenderline_llm_calls_total{status=\"ok\"}[1h]))",
     "legendFormat": "ok",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "row",
   "title": "LLM",
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 13,
   "title": "LLM cost per organisation (USD, 24h)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (org_id) (increase(tenderline_llm_cost_usd_total[24h]))",
     "legendFormat": "{{org_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 14,
   "title": "LLM latency p95 by provider",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(tenderline_llm_latency_milliseconds_bucket[15m])))",
     "legendFormat": "{{provider}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 15,
   "title": "LLM calls by status",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, status) (increase(tenderline_llm_calls_total[1h]))",
     "legendFormat": "{{provider}} {{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 16,
   "type": "row",
   "title": "Traces and logs",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 17,
   "title": "Recent traces (API -> queue -> LLM -> DB)",
   "type": "table",
   "description": "",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ resource.service.name = \"tenderline-api\" && (name =~ \"POST.*\" || name =~ \"queue.*\" || name = \"llm.complete\") }",
     "limit": 20,
     "tableType": "traces"
    }
   ]
  },
  {
   "id": 18,
   "title": "Logs (JSON, with trace ids)",
   "type": "logs",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 46,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=\"tenderline-api\"}",
     "queryType": "range"
    }
   ]
  }
 ],
