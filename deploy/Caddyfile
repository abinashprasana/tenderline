# Caddy obtains and renews TLS certificates automatically for {$DOMAIN} (DNS must point at the VM).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	log {
		output stdout
		format json
	}
}
